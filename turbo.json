{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "typecheck": {
      "env": ["DATABASE_URL"]
    }
  }
}

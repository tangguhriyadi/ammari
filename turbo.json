{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_KEY_PREFIX",
    "STORAGE_PUBLIC_BASE_URL",
    "STORAGE_DRIVER"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "typecheck": {
      "env": ["DATABASE_URL"]
    },
    "test": {
      "env": ["DATABASE_URL"]
    }
  }
}

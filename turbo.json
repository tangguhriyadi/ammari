{
  "$schema": "https://turborepo.com/schema.json",
  "envMode": "strict",
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_BUCKET",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_KEY_PREFIX",
    "STORAGE_PUBLIC_BASE_URL",
    "STORAGE_DRIVER",
    // REVALIDATE_SECRET/PREVIEW_SECRET/WEB_INTERNAL_URL (docs/plans/storefront-cms.md session 6):
    // same "lazy, request-time only" shape as the S3 vars above — read inside a function body
    // (lib/revalidate.ts, lib/web-internal-url.ts, app/api/revalidate/route.ts,
    // lib/preview/token.ts), never at module load, so `next build`'s page-data collection never
    // needs them — only the running server does, at request time.
    "REVALIDATE_SECRET",
    "PREVIEW_SECRET",
    "WEB_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // BETTER_AUTH_URL: packages/auth's create-{staff,customer}-auth.ts reads this eagerly at
      // module load (not just at request time), and that module is reachable from every
      // page/route — `next build`'s page-data-collection step throws without it. Discovered
      // building apps/admin/Dockerfile/apps/web/Dockerfile, where (unlike a local `pnpm build`,
      // which Next's own dotenv loading satisfies straight from apps/*/.env regardless of what
      // turbo passes through) there is no .env file at all, only a real process env var — which
      // turbo's strict envMode silently drops unless declared here. STAFF_BETTER_AUTH_SECRET/
      // CUSTOMER_BETTER_AUTH_SECRET: same discovery — `next build` always runs with
      // NODE_ENV=production (Next sets this itself, regardless of the ambient shell), which
      // trips create-{staff,customer}-auth.ts's "refuse to start with no secret in production"
      // check during page-data collection.
      "env": ["DATABASE_URL", "BETTER_AUTH_URL", "STAFF_BETTER_AUTH_SECRET", "CUSTOMER_BETTER_AUTH_SECRET"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL"]
    },
    "lint": {},
    "typecheck": {
      "env": ["DATABASE_URL"]
    },
    "test": {
      // DB-backed suites (packages/db, packages/auth, apps/admin, apps/web) all migrate+seed
      // and then read/write the SAME shared `ammari_test` Postgres database
      // (packages/db/test/global-setup.ts) — running two of them at once races both at setup
      // time (two concurrent migrate/seed runs) and during the tests themselves (no per-suite
      // isolation beyond each file's own transaction). `^test` orders a package's test task
      // after its dependencies' test tasks, which naturally serializes
      // @ammari/db -> @ammari/auth -> {@ammari/admin, @ammari/web} (both depend on
      // @ammari/auth and @ammari/db, neither depends on the other). It does NOT serialize
      // @ammari/admin against @ammari/web, since they're siblings with no package dependency
      // between them — apps/web/turbo.json adds the one remaining edge
      // (@ammari/admin#test -> @ammari/web#test) to close that gap. @ammari/ui,
      // @ammari/storage, and @ammari/content-sanitize touch no database at all, so they're
      // deliberately left out of this chain and keep running fully in parallel with everything
      // else — global `concurrency` stays at its default rather than forcing the whole
      // monorepo serial just for the four packages that actually share a database.
      "dependsOn": ["^test"],
      "env": ["DATABASE_URL"]
    }
  }
}

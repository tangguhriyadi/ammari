{
  "name": "@ammari/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/client.ts",
    "./schema": "./src/schema/index.ts",
    "./rbac": "./src/rbac/permissions.ts",
    "./catalog": "./src/catalog/codes.ts",
    "./highlights": "./src/catalog/highlights.ts",
    "./why-ammari": "./src/catalog/why-ammari.ts",
    "./storefront": "./src/storefront/queries.ts",
    "./storefront-settings": "./src/storefront/settings.ts",
    "./sql-helpers": "./src/sql-helpers.ts",
    "./stock-availability": "./src/stock-availability.ts",
    "./test-utils": "./test/helpers.ts",
    "./test-fixtures": "./test/fixtures.ts",
    "./test-global-setup": "./test/global-setup.ts",
    "./test-e2e-db": "./test/e2e-db.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:check": "tsx --env-file=.env src/check.ts",
    "db:seed": "tsx --env-file=.env src/seed.ts",
    "db:seed:dev": "tsx --env-file=.env src/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "postgres": "3.4.9",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}

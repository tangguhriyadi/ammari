[Unit]
Description=Run backup-check.service daily at 09:00 Asia/Jakarta

[Timer]
OnCalendar=*-*-* 09:00:00 Asia/Jakarta
# Catches up on a missed run (VPS reboot/maintenance window spanning 09:00) instead of silently
# waiting a full 24h for the next scheduled time.
Persistent=true
Unit=backup-check.service

[Install]
WantedBy=timers.target

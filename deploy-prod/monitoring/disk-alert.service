[Unit]
Description=Ammari prod: hourly disk-usage alert check
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/ammari-prod/monitoring
ExecStart=/opt/ammari-prod/monitoring/disk-alert.sh
# Everything this script prints is safe to keep in the journal — it never echoes a secret value
# (see its own header comment, and alert-lib.sh's). `journalctl -u disk-alert.service` is the way
# to check a run's output; no separate log file to manage or rotate.
StandardOutput=journal
StandardError=journal

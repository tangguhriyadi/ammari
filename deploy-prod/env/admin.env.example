# Server-side runtime env for apps/admin, PROD environment (docs/deploy-prod.md, Session 7).
# Lives ONLY on the VPS at /opt/ammari-prod/env/admin.env — never in this repo, never in GitHub.
# Copy this file there and fill in real values once, by hand, during one-time server setup
# (docs/plans/prod-deploy.md §4 step 10).
#
# Adapted from deploy/env/admin.env.example (dev) — the differences are the database target
# (self-hosted container, not managed Sumopod) and the domains. Still trimmed down from
# apps/admin/.env.example: no E2E_TEST_LOGIN/STORAGE_DRIVER (e2e/test-only, never set on a real
# server).

# Self-hosted Postgres, reached over the `internal` Docker network at the `db` service's compose
# name (deploy-prod/docker-compose.yml) — NOT a public host/port the way dev's managed Sumopod
# instance is. User/password/database here must match deploy-prod/env/db.env's own
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB exactly (same credentials, two files). `sslmode` is
# moot (same-host, over the Docker bridge, traffic never leaves the VPS) but kept explicit as
# "disable" so Drizzle's pg driver doesn't attempt a TLS handshake against a local Postgres that
# was never configured to speak it.
DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>?sslmode=disable

# This admin app's own public origin. Prod has no apex-vs-www ambiguity for the admin subdomain
# the way web does below — there's only ever `admin.ammari.id`.
BETTER_AUTH_URL=https://admin.ammari.id

# apps/web's own public base URL — every thank-you-card claim URL this app generates is built
# from this (apps/admin/src/lib/main-site-url.ts). The APEX, not `www.` — see web.env.example's
# own BETTER_AUTH_URL comment for why. Get this wrong and every card/sticker printed in prod
# points at the wrong site.
MAIN_SITE_URL=https://ammari.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is). Fresh secret for prod — never reuse
# dev's value (docs/plans/prod-deploy.md "Decisions already made").
STAFF_BETTER_AUTH_SECRET=

# Same Google OAuth CLIENT as dev — just with prod's redirect URIs/origins additionally
# registered on it (docs/plans/prod-deploy.md §4 step 9), and the consent screen flipped to
# "In production". Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes) — a SEPARATE Resend API key for prod, same already-verified
# mail.ammari.id domain (docs/plans/prod-deploy.md §4 step 8). Never reuse dev's key.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — whole-system cap on OTP sends per hour, checked against a count shared with
# apps/web (same auth_email_throttle table), protecting the Resend quota and mail.ammari.id's
# sender reputation (docs/SPEC.md §10.1). Defaults to 300/hour (packages/auth's
# DEFAULT_OTP_GLOBAL_HOURLY_CAP) when left blank. Each app reads its OWN copy of this var
# independently against that one shared count — set the SAME value in both admin.env and
# web.env if changing it from the default.
OTP_GLOBAL_HOURLY_CAP=

# apps/web's INTERNAL Docker-network URL — NOT the public MAIN_SITE_URL above. A plain
# server-to-server fetch to the public hostname has no Cloudflare Authenticated Origin Pulls
# client certificate and would be rejected by Caddy; this stays entirely inside the `internal`
# Docker network. Used only by /api/revalidate calls (docs/plans/storefront-cms.md session 6).
#
# Unlike dev (one `web` service), prod runs two web slots (web-blue/web-green,
# deploy-prod/docker-compose.yml) for blue-green deploys — "web" below is a floating network
# alias that deploy-prod/remote-deploy.sh (Session 3) repoints at whichever slot is currently
# active on every slot flip, not a literal compose service name. Do not change this to
# "web-blue"/"web-green" directly.
WEB_INTERNAL_URL=http://web:3000

# Shared with web.env's own REVALIDATE_SECRET below — same value in BOTH files. Generate with:
# openssl rand -base64 32. Authenticates admin's calls to apps/web's /api/revalidate (on-demand
# cache invalidation after "Terbitkan" and product storefront saves) — there is no staff session
# on that call, so this secret IS the whole auth boundary. A missing/wrong value never breaks a
# save/publish (logged, not thrown) — see src/lib/revalidate.ts. Fresh value for prod.
REVALIDATE_SECRET=

# Shared with web.env's own PREVIEW_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Signs the short-lived "Pratinjau" link this app mints for the DRAFT
# homepage, verified by apps/web (apps/admin/src/lib/content/preview-token.ts) — a wrong/missing
# value here means every "Pratinjau" link 404s on apps/web. Fresh value for prod.
PREVIEW_SECRET=

# Product image storage — prod's OWN dedicated Cloudflare R2 bucket (`ammari-prod`, endpoint
# https://<account-id>.r2.cloudflarestorage.com, region "auto" — docs/plans/storage-r2.md
# Session 3; filled in automatically by deploy-prod/make-prod-env.sh, which reads the real
# endpoint/bucket/credentials — never prompts for them). Never reuse dev's bucket or
# credentials. Nightly encrypted Postgres backups no longer share this bucket/credential — they
# go to their own dedicated, private `ammari-prod-backups` R2 bucket with its own scoped token,
# read by deploy-prod/backup/pg-backup.sh and deploy-prod/monitoring/backup-check.sh from
# env/backup.env's BACKUP_S3_* vars (docs/plans/storage-r2.md Session 2). S3_* below is never
# used by apps/admin or apps/web themselves either way — only by packages/storage's upload
# paths.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Deliberately EMPTY, unlike dev's "dev/" — this is a dedicated single-purpose bucket (not
# shared with another environment the way dev's is with local). R2 has no bucket-policy concept
# and no prefix-scoped public-read rule to match either way — the whole bucket is public via its
# Cloudflare custom domain (docs/plans/storage-r2.md "Decisions already made") regardless of key
# prefix. Kept empty here purely for consistency with how objects are actually keyed
# (unprefixed products/*, content/*, healthcheck/*), not because a non-empty value would break
# anything on the R2 side.
S3_KEY_PREFIX=
STORAGE_PUBLIC_BASE_URL=

# Private storage for supplier payment proofs (docs/plans/purchase-payments.md §5): the PRIVATE
# bucket ammari-prod-private (no custom domain, no public access, optional bucket lock rule) with
# its own R2 token scoped to that bucket only. Reuses S3_ENDPOINT, S3_REGION and S3_KEY_PREFIX
# above. Must differ from S3_BUCKET / S3_ACCESS_KEY_ID (refused otherwise). Never set
# PRIVATE_STORAGE_DRIVER here.
PRIVATE_S3_BUCKET=
PRIVATE_S3_ACCESS_KEY_ID=
PRIVATE_S3_SECRET_ACCESS_KEY=

# Which environment this is (docs/plans/cart-checkout.md §12). The payment guard requires
# production mode here and refuses a sandbox key; one of production, dev, development, test, and
# anything else fails closed.
DEPLOY_ENV=production

# Midtrans, for staff cancels of UNPAID web orders only (plan §6.5, session 16): the same
# PRODUCTION server key as web.env. Unset: such a cancel is refused with a message; paid orders can
# still be cancelled. Set with deploy/set-env-var.sh in ~/ammari-secrets/prod-admin.env
# (docs/launch/checkout-prod.md).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

# Courier booking (docs/plans/cart-checkout.md §12, §15 Phase K, K2): "Pesan kurir", "Cek ulang
# pemesanan", "Batalkan pengiriman" and "Cetak label". Prod uses the same LIVE key as web.env
# ("biteship_live."; real couriers pick up), only after Biteship activated the live Order API; a test
# key is refused here. Unset or invalid: booking is refused with a message and staff use the manual
# resi path. Set the values with deploy/set-env-var.sh in ~/ammari-secrets/prod-admin.env (the K4 runbook says what to put);
# values never go in the repo.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
# Ammari's own Biteship area id, the same value as web.env.
BITESHIP_ORIGIN_AREA_ID=
# Ammari as sender and pickup contact (decision 50): name 2 to 60 characters, an Indonesian mobile
# number, the pickup street address 10 to 300 characters.
BITESHIP_SHIPPER_NAME=
BITESHIP_SHIPPER_PHONE=
BITESHIP_SHIPPER_ADDRESS=
# Reference id prefix (decision 51): empty in production (or a prod-only prefix); DEV-, LOCAL-, E2E-,
# CT- and TEST- are refused here.
BITESHIP_REFERENCE_PREFIX=
# Optional daily cap on order reads (default 60).
BITESHIP_DAILY_ORDERS_BUDGET=

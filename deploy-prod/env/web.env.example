# Server-side runtime env for apps/web, PROD environment (docs/deploy-prod.md, Session 7).
# Lives ONLY on the VPS at /opt/ammari-prod/env/web.env — never in this repo, never in GitHub.
# Copy this file there and fill in real values once, by hand, during one-time server setup
# (docs/plans/prod-deploy.md §4 step 10).
#
# Adapted from deploy/env/web.env.example (dev) — the differences are the database target
# (self-hosted container, not managed Sumopod), the domains, DEPLOY_ENV, and
# STOREFRONT_CART_ENABLED's warning below.

# Self-hosted Postgres, reached over the `internal` Docker network at the `db` service's compose
# name (deploy-prod/docker-compose.yml) — NOT a public host/port the way dev's managed Sumopod
# instance is. User/password/database here must match deploy-prod/env/db.env's own
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB exactly (same credentials, two files). `sslmode` is
# moot (same-host, over the Docker bridge, traffic never leaves the VPS) but kept explicit as
# "disable" so Drizzle's pg driver doesn't attempt a TLS handshake against a local Postgres that
# was never configured to speak it.
DATABASE_URL=postgresql://<user>:<password>@db:5432/<database>?sslmode=disable

# This app's own public origin. Deliberately the APEX (https://ammari.id), not
# https://www.ammari.id — www is only ever a 301 redirect to the apex
# (docs/plans/prod-deploy.md §2 "www handling"; deploy-prod/Caddyfile, Session 2), and
# apps/web/src/app/layout.tsx's `metadataBase` is built from this exact value, so getting it
# wrong here would resolve every canonical/OG URL the site emits to the wrong host.
BETTER_AUTH_URL=https://ammari.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is). Fresh secret for prod — never reuse
# dev's value (docs/plans/prod-deploy.md "Decisions already made").
CUSTOMER_BETTER_AUTH_SECRET=

# Same Google OAuth CLIENT as dev — just with prod's redirect URIs/origins additionally
# registered on it (docs/plans/prod-deploy.md §4 step 9), and the consent screen flipped to
# "In production". Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes) — a SEPARATE Resend API key for prod, same already-verified
# mail.ammari.id domain (docs/plans/prod-deploy.md §4 step 8). Never reuse dev's key.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — see admin.env.example's own copy of this var. The cap it configures is checked
# against a single shared count (both apps write to the same auth_email_throttle table), but
# each app reads its OWN copy of this env var independently — set the SAME value in both
# admin.env and web.env if changing it from the default, or the two apps will enforce different
# numbers against that one shared pool.
OTP_GLOBAL_HOURLY_CAP=

# Shared with admin.env's own REVALIDATE_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Gates POST /api/revalidate (apps/admin calls this over the internal
# Docker network after "Terbitkan" and product storefront saves — docs/plans/storefront-cms.md
# session 6). Checked with a constant-time comparison; missing/wrong -> 401. This path is ALSO
# blocked at the Caddy layer for the public hostname (deploy-prod/Caddyfile, Session 2) — defense
# in depth in case this secret ever leaks, since Cloudflare's Authenticated Origin Pulls on its
# own only proves a request came through Cloudflare, not that it's a legitimate admin request.
# Fresh value for prod.
REVALIDATE_SECRET=

# Shared with admin.env's own PREVIEW_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Verifies the short-lived "Pratinjau" link admin mints for the DRAFT
# homepage (/preview/home?token=...) — HMAC + expiry, verified here, never a real login. Fresh
# value for prod.
PREVIEW_SECRET=

# The ONE env var that differs between this file and dev's otherwise-identical image
# (apps/web/src/app/robots.ts, docs/plans/deploy-dev.md) — only the literal "production" value
# allows search engines to index the site. This is prod, so it IS "production" here (the
# opposite of dev's deploy/env/web.env.example, which pins "dev" — don't copy that value here).
DEPLOY_ENV=production

# Same bucket/CDN as admin.env's own STORAGE_PUBLIC_BASE_URL — use the EXACT SAME VALUE as that
# file (the SEPARATE prod bucket, docs/plans/prod-deploy.md §4 step 7 — never dev's bucket).
# apps/web never uploads/deletes/holds an S3 credential (no S3_* vars here at all); it only reads
# a product/content image's already-stored `storageKey` (which already embeds admin.env's own
# S3_KEY_PREFIX, e.g. "prod/products/...") and appends it to this base URL to render an
# `<img>`/`next/image` src (lib/storage/public-url.ts). Read at RUNTIME only, never at `next
# build` time — but set it before the first real deploy regardless, or every page with an image
# throws a clean, logged 500 instead of rendering.
STORAGE_PUBLIC_BASE_URL=

# FALLBACK ONLY for store_settings.whatsapp_number — apps/web/src/lib/store-settings.ts's
# getWhatsappNumber() reads the database value first and only falls back to this env var when
# that's empty. Do not rely on this in prod: set the real number in admin (Content → Settings,
# docs/plans/prod-deploy.md §4 step 19 / §3 Session 8) instead. Kept here only because
# apps/web/playwright.config.ts's e2e suite already depends on this var being settable. wa.me
# format: country code + digits only, no "+" (e.g. "6281234567890"). Unset hides the PDP's
# "Tanya via WhatsApp" button entirely rather than rendering a broken link.
STORE_WHATSAPP_NUMBER=

# WARNING — do not flip this to "true" in prod until cart/checkout actually ships (planned
# Dec 2026, docs/plans/prod-deploy.md Summary). This early prod launch is deliberately
# checkout-off: WhatsApp is the primary CTA, payment gateway submission assumes no live cart.
# Flipping this on prematurely would expose an unfinished/unreviewed checkout flow to real
# customers. Feature flag for the "Tambah ke keranjang" UI (lib/cart-flag.ts); anything other
# than the literal "true" keeps it hidden. Server-side only, deliberately NOT NEXT_PUBLIC_ (this
# image is built once and deployed environment-neutral — a NEXT_PUBLIC_ value would be baked into
# the client bundle at build time and unflippable per-environment without a rebuild).
STOREFRONT_CART_ENABLED=false

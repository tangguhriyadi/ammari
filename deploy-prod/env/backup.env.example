# Backup encryption + alerting config, prod environment (docs/plans/prod-deploy.md §4 step 10,
# §6). Lives ONLY on the VPS at /opt/ammari-prod/env/backup.env — never in this repo, never in
# GitHub.
#
# BACKUP_S3_* below is a DEDICATED Cloudflare R2 bucket + API token for backups only
# (docs/plans/storage-r2.md Session 2) — a separate bucket, separate scoped token from
# env/admin.env's media-bucket S3_* credentials, never the same key. deploy-prod/backup/
# pg-backup.sh and deploy-prod/monitoring/backup-check.sh read ONLY from this file for S3 access;
# neither loads env/admin.env at all.

# Generate with: openssl rand -base64 48. Used by deploy-prod/backup/pg-backup.sh to AES-256
# encrypt each nightly pg_dump before it ever leaves the VPS. LOSING THIS KEY MAKES EVERY
# EXISTING ENCRYPTED BACKUP PERMANENTLY UNREADABLE — there is no recovery path. Keep a copy in a
# password manager too, the moment it's generated, not just in this file
# (docs/plans/prod-deploy.md §6).
PG_BACKUP_ENCRYPTION_KEY=

# Comma-separated recipient list for the backup-success and disk-space alert emails (sent via the
# prod Resend API key already in admin.env, no new credential needed). Confirmed recipients: the
# shop's own inbox and the owner's address (docs/plans/prod-deploy.md §6).
ALERT_EMAIL_TO=

# Cloudflare R2, bucket `ammari-prod-backups` — private, never public, no custom domain
# (docs/plans/storage-r2.md "Decisions already made"). Region is always "auto" for R2. The
# `backups/daily/`+`backups/weekly/` key layout lives INSIDE this bucket unchanged (same prefixes
# pg-backup.sh already wrote under the old shared bucket) — kept for consistency with the
# scripts' existing prune logic, even though the bucket itself is now single-purpose and the
# prefix is no longer needed to separate backups from product/content images.
BACKUP_S3_ENDPOINT=https://d99c5045ed359887e8fdd591cc492ee9.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto

# Bucket scoped to backups only — never the media bucket (env/admin.env's S3_BUCKET).
BACKUP_S3_BUCKET=ammari-prod-backups

# The `ammari-prod-backups`-scoped R2 API token (Object Read & Write, that one bucket only) —
# NEVER the media bucket's token. Generated once in the Cloudflare dashboard; the owner's own
# copies live on their Mac at ~/ammari-secrets/r2-backups-access-key and
# ~/ammari-secrets/r2-backups-secret-key, never in this repo.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# Nightly copy of the private proof files (payment proofs, supplier notas) into the backups bucket
# above, under private-files/ (docs/plans/purchase-payments.md A7; deploy-prod/backup/
# proof-backup.sh). The SOURCE is the private bucket `ammari-prod-private`, read with its own R2
# API token that is READ-ONLY ("Object Read only") and scoped to that one bucket, never the admin
# app's read & write token, so this host can never write or delete a proof. The owner's copies of
# that token live on their Mac at ~/ammari-secrets/r2-prod-private-readonly-access-key and
# ~/ammari-secrets/r2-prod-private-readonly-secret-key; deploy-prod/make-prod-env.sh writes them
# here. Leaving PROOF_BACKUP_SOURCE_BUCKET empty turns the job off (proof-backup.sh refuses to run,
# backup-check.sh skips the proof check).
PROOF_BACKUP_SOURCE_BUCKET=ammari-prod-private
PROOF_BACKUP_SOURCE_ACCESS_KEY_ID=
PROOF_BACKUP_SOURCE_SECRET_ACCESS_KEY=

# DEFAULT checked into this repo so deploy-prod/Caddyfile validates and runs correctly before
# Session 3 (docs/plans/prod-deploy.md §3) exists at all — both apps start on their "blue" slot
# the first time the stack ever comes up (deploy-prod/docker-compose.yml's admin-blue/web-blue).
#
# From Session 3 onward, this file is REGENERATED, not hand-edited: deploy-prod/remote-deploy.sh
# rewrites it to name whichever slot (blue or green) is currently active for each app — read from
# /opt/ammari-prod/active-slot-admin and /opt/ammari-prod/active-slot-web — then runs
# `caddy reload` so the new upstream takes effect with no downtime and no Caddyfile change. Mounted
# read-only into the caddy container at /etc/caddy/generated/active-upstream.caddy
# (deploy-prod/docker-compose.yml's `./caddy:/etc/caddy/generated:ro`) and imported once, by
# ../Caddyfile, before either site block that uses these two named snippets.
(active_upstream_web) {
	reverse_proxy web-blue:3000
}

(active_upstream_admin) {
	reverse_proxy admin-blue:3000
}

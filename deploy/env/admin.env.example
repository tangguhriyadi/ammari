# Server-side runtime env for apps/admin, dev environment (docs/deploy.md). Lives ONLY on the
# VPS at /opt/ammari/env/admin.env — never in this repo, never in GitHub. Copy this file there
# and fill in real values once, by hand, during one-time server setup.
#
# Trimmed down from apps/admin/.env.example: no E2E_TEST_LOGIN/STORAGE_DRIVER (e2e/test-only,
# never set on a real server).

# Sumopod SHARED Postgres 16.13, DIRECT connection — NOT the PgBouncer ports (6432/6433; they
# break Drizzle's assumptions about advisory locks/prepared statements, see
# packages/db/src/production/batch-number.ts and orders/order-number.ts). No SSL on this
# instance (dev only — prod will be TLS), so sslmode=disable here, not blank. Username has the
# ".jkt1_003" suffix stripped (confirmed working form from Sumopod's dashboard).
DATABASE_URL=postgresql://<user-without-suffix>:<password>@pgsql-dbas-jkt1-003.sumobase.my.id:65434/<database>?sslmode=disable

# This admin app's own public origin.
BETTER_AUTH_URL=https://admin.ammari.my.id

# apps/web's own public base URL — every thank-you-card claim URL this app generates is built
# from this (apps/admin/src/lib/main-site-url.ts). Get this wrong and every card/sticker printed
# in this environment points at the wrong site.
MAIN_SITE_URL=https://ammari.my.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is).
STAFF_BETTER_AUTH_SECRET=

# Reuses the existing Google OAuth client already registered for local dev — the dev callback
# URL (https://admin.ammari.my.id/api/auth/callback/google) is already added there (owner-
# confirmed, docs/plans/deploy-dev.md open question 6). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes) — shared with apps/web's own customer login, same provider account.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — whole-system cap on OTP sends per hour, checked against a count shared with
# apps/web (same auth_email_throttle table), protecting the Resend quota and mail.ammari.id's
# sender reputation (docs/SPEC.md §10.1). Defaults to 300/hour (packages/auth's
# DEFAULT_OTP_GLOBAL_HOURLY_CAP) when left blank. Each app reads its OWN copy of this var
# independently against that one shared count — set the SAME value in both admin.env and
# web.env if changing it from the default.
OTP_GLOBAL_HOURLY_CAP=

# apps/web's INTERNAL Docker-network URL (the `web` service's own compose name, port 3000 —
# see deploy/docker-compose.yml) — NOT the public MAIN_SITE_URL above. A plain server-to-server
# fetch to the public hostname has no Cloudflare Authenticated Origin Pulls client certificate
# and would be rejected by Caddy; this stays entirely inside the `internal` Docker network.
# Used only by /api/revalidate calls (docs/plans/storefront-cms.md session 6).
WEB_INTERNAL_URL=http://web:3000

# Shared with web.env's own REVALIDATE_SECRET below — same value in BOTH files. Generate with:
# openssl rand -base64 32. Authenticates admin's calls to apps/web's /api/revalidate (on-demand
# cache invalidation after "Terbitkan" and product storefront saves) — there is no staff session
# on that call, so this secret IS the whole auth boundary. A missing/wrong value never breaks a
# save/publish (logged, not thrown) — see src/lib/revalidate.ts.
REVALIDATE_SECRET=

# Product image storage — Cloudflare R2 (S3-compatible), dev/ prefix
# (docs/plans/storage-r2.md).
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=dev/
STORAGE_PUBLIC_BASE_URL=

# Which environment this is (docs/plans/cart-checkout.md §12). Required by the payment guard: the
# image is a production build, so without DEPLOY_ENV=dev the sandbox settings below are refused.
# One of production, dev, development, test; anything else fails closed.
DEPLOY_ENV=dev

# Midtrans, for staff cancels of UNPAID web orders only (plan §6.5, session 16): the same SANDBOX
# server key and mode as web.env. Unset: such a cancel is refused with a message; paid orders can
# still be cancelled. Set with /opt/ammari/set-env-var.sh (docs/launch/checkout-dev.md).
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Courier booking (docs/plans/cart-checkout.md §12, §15 Phase K, K2): "Pesan kurir", "Cek ulang
# pemesanan", "Batalkan pengiriman" and "Cetak label". Dev uses the same TEST key as web.env
# ("biteship_test."; test-mode orders are simulated, no pickup); a live key is refused outside
# DEPLOY_ENV=production. Unset or invalid: booking is refused with a message and staff use the manual
# resi path. Set the values with /opt/ammari/set-env-var.sh (the K4 runbook says what to put);
# values never go in the repo.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
# Ammari's own Biteship area id, the same value as web.env.
BITESHIP_ORIGIN_AREA_ID=
# Ammari as sender and pickup contact (decision 50): name 2 to 60 characters, an Indonesian mobile
# number, the pickup street address 10 to 300 characters.
BITESHIP_SHIPPER_NAME=
BITESHIP_SHIPPER_PHONE=
BITESHIP_SHIPPER_ADDRESS=
# Reference id prefix (decision 51): required outside production, because dev and local share one
# Biteship test account. A-Z, 0-9 and '-', at most 16 characters.
BITESHIP_REFERENCE_PREFIX=DEV-
# Optional daily cap on order reads (default 60).
BITESHIP_DAILY_ORDERS_BUDGET=

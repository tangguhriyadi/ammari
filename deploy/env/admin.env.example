# Server-side runtime env for apps/admin, dev environment (docs/deploy.md). Lives ONLY on the
# VPS at /opt/ammari/env/admin.env — never in this repo, never in GitHub. Copy this file there
# and fill in real values once, by hand, during one-time server setup.
#
# Trimmed down from apps/admin/.env.example: no E2E_TEST_LOGIN/STORAGE_DRIVER (e2e/test-only,
# never set on a real server).

# Sumopod SHARED Postgres 16.13, DIRECT connection — NOT the PgBouncer ports (6432/6433; they
# break Drizzle's assumptions about advisory locks/prepared statements, see
# packages/db/src/production/batch-number.ts and orders/order-number.ts). No SSL on this
# instance (dev only — prod will be TLS), so sslmode=disable here, not blank. Username has the
# ".jkt1_003" suffix stripped (confirmed working form from Sumopod's dashboard).
DATABASE_URL=postgresql://<user-without-suffix>:<password>@pgsql-dbas-jkt1-003.sumobase.my.id:65434/<database>?sslmode=disable

# This admin app's own public origin.
BETTER_AUTH_URL=https://admin.ammari.my.id

# apps/web's own public base URL — every thank-you-card claim URL this app generates is built
# from this (apps/admin/src/lib/main-site-url.ts). Get this wrong and every card/sticker printed
# in this environment points at the wrong site.
MAIN_SITE_URL=https://ammari.my.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is).
STAFF_BETTER_AUTH_SECRET=

# Reuses the existing Google OAuth client already registered for local dev — the dev callback
# URL (https://admin.ammari.my.id/api/auth/callback/google) is already added there (owner-
# confirmed, docs/plans/deploy-dev.md open question 6). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes) — shared with apps/web's own customer login, same provider account.
RESEND_API_KEY=
EMAIL_FROM=

# Product image storage — Cloudeka S3, dev/ prefix.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=dev/
STORAGE_PUBLIC_BASE_URL=

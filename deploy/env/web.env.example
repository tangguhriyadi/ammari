# Server-side runtime env for apps/web, dev environment (docs/deploy.md). Lives ONLY on the
# VPS at /opt/ammari/env/web.env — never in this repo, never in GitHub. Copy this file there and
# fill in real values once, by hand, during one-time server setup.

# Same Sumopod database as admin.env — see that file's comment for the exact connection shape
# (direct port 65434, not PgBouncer, sslmode=disable in dev, username without ".jkt1_003").
DATABASE_URL=postgresql://<user-without-suffix>:<password>@pgsql-dbas-jkt1-003.sumobase.my.id:65434/<database>?sslmode=disable

# This app's own public origin.
BETTER_AUTH_URL=https://ammari.my.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is).
CUSTOMER_BETTER_AUTH_SECRET=

# Reuses the existing Google OAuth client already registered for local dev — the dev callback
# URL (https://ammari.my.id/api/auth/callback/google) is already added there (owner-confirmed,
# docs/plans/deploy-dev.md open question 6). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes) — shared with apps/admin's own staff login, same provider account.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — see admin.env.example's own copy of this var. The cap it configures is checked
# against a single shared count (both apps write to the same auth_email_throttle table), but
# each app reads its OWN copy of this env var independently — set the SAME value in both
# admin.env and web.env if changing it from the default, or the two apps will enforce different
# numbers against that one shared pool.
OTP_GLOBAL_HOURLY_CAP=

# Shared with admin.env's own REVALIDATE_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Gates POST /api/revalidate (apps/admin calls this over the internal
# Docker network after "Terbitkan" and product storefront saves — docs/plans/storefront-cms.md
# session 6). Checked with a constant-time comparison; missing/wrong -> 401. This path is ALSO
# blocked at the Caddy layer for the public hostname (deploy/Caddyfile) — defense in depth in
# case this secret ever leaks, since Cloudflare's Authenticated Origin Pulls on its own only
# proves a request came through Cloudflare, not that it's a legitimate admin request.
REVALIDATE_SECRET=

# Shared with admin.env's own PREVIEW_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Signs the short-lived "Pratinjau" link admin mints for the DRAFT
# homepage (/preview/home?token=...) — HMAC + expiry, verified here, never a real login.
PREVIEW_SECRET=

# The ONE env var that differs between this file and prod's otherwise-identical image
# (apps/web/src/app/robots.ts, docs/plans/deploy-dev.md) — only the literal "production" value
# allows search engines to index the site. Dev is never "production" here, deliberately.
DEPLOY_ENV=dev

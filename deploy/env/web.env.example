# Server-side runtime env for apps/web, dev environment (docs/deploy.md). Lives ONLY on the
# VPS at /opt/ammari/env/web.env — never in this repo, never in GitHub. Copy this file there and
# fill in real values once, by hand, during one-time server setup.

# Same Sumopod database as admin.env — see that file's comment for the exact connection shape
# (direct port 65434, not PgBouncer, sslmode=disable in dev, username without ".jkt1_003").
DATABASE_URL=postgresql://<user-without-suffix>:<password>@pgsql-dbas-jkt1-003.sumobase.my.id:65434/<database>?sslmode=disable

# This app's own public origin.
BETTER_AUTH_URL=https://ammari.my.id

# Generate with: openssl rand -base64 32. Required — the app refuses to start without it once
# NODE_ENV=production (which the Docker image always is).
CUSTOMER_BETTER_AUTH_SECRET=

# Reuses the existing Google OAuth client already registered for local dev — the dev callback
# URL (https://ammari.my.id/api/auth/callback/google) is already added there (owner-confirmed,
# docs/plans/deploy-dev.md open question 6). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery (OTP codes and order emails) — shared with apps/admin's own staff login, same
# provider account.
RESEND_API_KEY=
EMAIL_FROM=

# apps/admin's public origin, for the "Buka di admin" link in the owner's paid-order email
# (optional; unset means no link).
ADMIN_SITE_URL=https://admin.ammari.my.id

# Optional — see admin.env.example's own copy of this var. The cap it configures is checked
# against a single shared count (both apps write to the same auth_email_throttle table), but
# each app reads its OWN copy of this env var independently — set the SAME value in both
# admin.env and web.env if changing it from the default, or the two apps will enforce different
# numbers against that one shared pool.
OTP_GLOBAL_HOURLY_CAP=

# Shared with admin.env's own REVALIDATE_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Gates POST /api/revalidate (apps/admin calls this over the internal
# Docker network after "Terbitkan" and product storefront saves — docs/plans/storefront-cms.md
# session 6). Checked with a constant-time comparison; missing/wrong -> 401. This path is ALSO
# blocked at the Caddy layer for the public hostname (deploy/Caddyfile) — defense in depth in
# case this secret ever leaks, since Cloudflare's Authenticated Origin Pulls on its own only
# proves a request came through Cloudflare, not that it's a legitimate admin request.
REVALIDATE_SECRET=

# Shared with admin.env's own PREVIEW_SECRET — same value in BOTH files. Generate with:
# openssl rand -base64 32. Signs the short-lived "Pratinjau" link admin mints for the DRAFT
# homepage (/preview/home?token=...) — HMAC + expiry, verified here, never a real login.
PREVIEW_SECRET=

# The ONE env var that differs between this file and prod's otherwise-identical image
# (apps/web/src/app/robots.ts, docs/plans/deploy-dev.md) — only the literal "production" value
# allows search engines to index the site. Dev is never "production" here, deliberately.
DEPLOY_ENV=dev

# Same bucket/CDN as admin.env's own STORAGE_PUBLIC_BASE_URL — use the EXACT SAME VALUE as that
# file. apps/web never uploads/deletes/holds an S3 credential (no S3_* vars here at all); it only
# reads a product/content image's already-stored `storageKey` (which already embeds admin.env's
# own S3_KEY_PREFIX, e.g. "dev/products/...") and appends it to this base URL to render an
# `<img>`/`next/image` src (lib/storage/public-url.ts). Read at RUNTIME only, never at `next
# build` time (next.config.ts's own comment explains why `images.remotePatterns` can't depend on
# it) — but set it before the first real deploy regardless, or every page with an image throws a
# clean, logged 500 instead of rendering.
STORAGE_PUBLIC_BASE_URL=

# Temporary stand-in for `store_settings.whatsapp_number` (docs/plans/storefront-cms.md Phase 2,
# session 8 — not built yet) — delete this var once that ships. wa.me format: country code +
# digits only, no "+" (e.g. "6281234567890"). Unset hides the PDP's "Tanya via WhatsApp" button
# entirely rather than rendering a broken link (lib/store-settings.ts).
STORE_WHATSAPP_NUMBER=

# Feature flag for the "Tambah ke keranjang" UI (lib/cart-flag.ts) — cart/checkout itself ships
# Dec 2026, not built yet. Defaults OFF (anything other than the literal "true" keeps it hidden);
# while off, the PDP's primary action is "Tanya via WhatsApp" instead. Server-side only,
# deliberately NOT NEXT_PUBLIC_ (this image is built once and deployed environment-neutral — a
# NEXT_PUBLIC_ value would be baked into the client bundle at build time and unflippable
# per-environment without a rebuild).
STOREFRONT_CART_ENABLED=false

# Bearer secret for the internal cron routes (/api/internal/payments/sweep every 5 minutes,
# /api/internal/retention daily; docs/plans/cart-checkout.md §6.3, §11), called only by the cron
# service on the internal network (deploy/cron/cron.sh). Must equal INTERNAL_CRON_SECRET in
# env/cron.env; at least 32 random characters (`openssl rand -hex 32`). Unset or shorter: the
# routes answer 503 and nothing is swept or pruned. Safe with STOREFRONT_CART_ENABLED=false (the
# sweep only acts on checkout orders that already exist).
INTERNAL_CRON_SECRET=

# --- Checkout (docs/plans/cart-checkout.md §12; runbook docs/launch/checkout-dev.md) ------------
# Every checkout path fails closed while these are missing: the area search and quotes answer
# "Ongkir belum bisa dihitung", checkout refuses before creating anything, and the payment
# notification route answers 503. Set them with deploy/set-env-var.sh (synced here as
# /opt/ammari/set-env-var.sh), never by pasting a secret into a command line. PAYMENT_PROVIDER and
# SHIPPING_RATE_PROVIDER are deliberately absent: their defaults (midtrans, biteship) are the only
# values a server may use ("fake" is refused outside an e2e build anyway).

# Midtrans SANDBOX on dev: the server key from dashboard.sandbox.midtrans.com (newer sandbox keys
# start with "Mid-server-" like production ones, older ones with "SB-"; checkout-dev.md B1 checks it
# against the Sandbox API).
# MIDTRANS_IS_PRODUCTION must be false here; "true" is refused unless DEPLOY_ENV=production.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# Dev and local share one Sandbox account, so dev's order ids carry a prefix (plan D7): A-Z, 0-9
# or "-", at most 16 characters. Prod leaves it empty.
MIDTRANS_ORDER_ID_PREFIX=DEV-
# Sent per transaction as X-Override-Notification (plan D8), so this environment gets its own
# notifications whatever the shared Sandbox dashboard says. One https URL.
MIDTRANS_NOTIFICATION_URL=https://ammari.my.id/api/payments/midtrans/notification
# Optional, owner decision 1: 60-minute payment window, 75-minute stock hold (must be longer).
CHECKOUT_PAYMENT_EXPIRY_MINUTES=
CHECKOUT_STOCK_HOLD_MINUTES=

# Biteship (shipping area search and rates, plan §4.5). Dev uses a TEST key ("biteship_test.");
# test-mode Maps and Rates are real data and billed per request on Starter, so keep a small
# balance. The real client is built only when key, base URL and origin are all set.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
# Ammari's own Biteship area id (kecamatan + kode pos of the shop), from a Maps search; never shown.
BITESHIP_ORIGIN_AREA_ID=
# Optional daily caps on outgoing Biteship calls (defaults 1500 Maps, 300 Rates per Jakarta day).
BITESHIP_DAILY_MAPS_BUDGET=
BITESHIP_DAILY_RATES_BUDGET=
# Optional, minutes a quote is reused from shipping_rate_cache (default 360).
SHIPPING_QUOTE_CACHE_MINUTES=

# --- Courier tracking (docs/plans/cart-checkout.md §12, §15 Phase K, K3) ---------------------------
# The Biteship webhook and the 3-hourly poller read courier bookings (made from admin) and move web
# orders to Dikirim and Selesai. Read-only here: no sender or reference prefix in this file. The same
# key rules as admin (a TEST key on dev). Without these the webhook ignores every post and the poll
# answers 503 (logged); staff can still ship and complete orders by hand.
# Optional daily cap on Biteship order reads (default 60), shared with admin's (same value in both).
BITESHIP_DAILY_ORDERS_BUDGET=
# The webhook URL registered in the Biteship dashboard is
# https://ammari.my.id/api/shipping/biteship/webhook/<BITESHIP_WEBHOOK_PATH_TOKEN>, with the header
# below in its "Headers Signature Key / Secret" fields. Path token: 32 to 128 of A-Z, a-z, 0-9, -, _
# (`openssl rand -hex 32`). Header name: a plain name such as X-Ammari-Courier-Secret (not a
# standard or proxy header). Header secret: 32 to 256 printable characters, no spaces
# (`openssl rand -hex 32`). All three must match the dashboard exactly.
BITESHIP_WEBHOOK_PATH_TOKEN=
BITESHIP_WEBHOOK_HEADER_NAME=
BITESHIP_WEBHOOK_HEADER_SECRET=

# The internal cron service (deploy/cron/cron.sh). Copy to env/cron.env on the server (chmod 600).
# Same value as INTERNAL_CRON_SECRET in env/web.env: at least 32 random characters, e.g.
# `openssl rand -hex 32`. Empty = the cron service idles (no expiry sweep, no retention).
INTERNAL_CRON_SECRET=

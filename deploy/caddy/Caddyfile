# Dev-environment Caddyfile (docs/deploy.md). Lives at deploy/caddy/Caddyfile, not
# deploy/Caddyfile (moved here in Session 10) — this directory is mounted WHOLE into the caddy
# container (`./caddy:/etc/caddy:ro` in docker-compose.yml), deliberately NOT a single-file bind
# mount of just this file. A single-file mount binds to the file's INODE, not its path; rsync's
# default replace-via-rename (writing a new file then renaming over the old one, same as every
# deploy's sync step does) swaps the inode at that path, and a running container with a
# single-file mount keeps serving the OLD inode's content forever — `caddy reload` reads that
# same stale bind mount and reports success while actually serving nothing new. Confirmed real
# on THIS environment (Session 10): the host file had the new content, the container's own
# `/etc/caddy/Caddyfile` did not, and only recreating the container fixed it. A directory mount
# doesn't have this problem — the container always resolves the path against whatever the host
# directory currently points to. See docs/deploy.md's Caddy-reload section.
#
# Prod got its own Caddyfile on its own VPS later (docs/plans/deploy-dev.md, open question 1) —
# deploy-prod/caddy/Caddyfile was copied from this one as the starting point, with the
# X-Robots-Tag lines removed, since every host in THIS file is a dev host.
#
# The Cloudflare trust boundary lives entirely here, not in ufw (docker publishes its own
# iptables rules that bypass ufw's filtering of published ports — see docs/plans/deploy-dev.md):
#   1. PRIMARY: Cloudflare Authenticated Origin Pulls — `client_auth` below requires the
#      Cloudflare origin-pull client certificate on every TLS handshake. A request that didn't
#      actually come through Cloudflare (direct to the VPS IP) is rejected before any
#      application code — or even an HTTP response — runs.
#   2. DEFENSE IN DEPTH: `cloudflare_only` (imported from deploy/cloudflare/cloudflare-only.caddy,
#      generated by deploy/update-cloudflare-ips.sh from deploy/cloudflare-ips.txt) rejects
#      anything whose remote IP isn't in Cloudflare's published ranges.
#   3. `trusted_proxies` (same source) makes access logs show the real client IP, not
#      Cloudflare's edge IP.
# This is what makes trusting `cf-connecting-ip` in packages/auth's rate limiting (and
# apps/web/src/lib/claim/ip.ts) safe — confirmed by reading that code: both read ONLY that
# header, never X-Forwarded-For, so nothing except Caddy's own enforcement stands between it and
# a spoofed value.
#
# VERIFY BEFORE RELYING ON THIS: `caddy validate --config /opt/ammari/Caddyfile` against the
# Caddy version actually installed on the VPS, then the runbook's own
# "curl the VPS IP directly, bypassing Cloudflare, must fail" step (docs/deploy.md).
{
	import cloudflare/trusted-proxies.caddy
}

import cloudflare/cloudflare-only.caddy

# Security headers for every PUBLIC site block below. No Content-Security-Policy yet —
# deliberately deferred, see docs/deploy-prod.md (prod's own copy of this snippet, which dev's
# Caddyfile should keep matching). `-Server` drops Caddy's own default `Server: Caddy` response
# header. Each of these is imported TWICE in its site block below: once for the normal response
# path, and again inside a `handle_errors` block — confirmed empirically (local `caddy run`
# against a deliberately-unreachable upstream) that a `header` directive alone does NOT reliably
# survive a reverse_proxy failure (502): Caddy's built-in error-response path re-adds
# `Server: Caddy` and drops the rest on that path specifically. See deploy-prod/Caddyfile's own
# copy of this comment for the full explanation.
(web_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# SAMEORIGIN + geolocation disabled — same reasoning as deploy-prod/Caddyfile's own copy
		# of this block (no iframe embedding anywhere in this codebase, no geolocation/map-pin
		# feature in code or docs/plans/*.md yet).
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

(admin_security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# DENY — admin is never framed anywhere in this codebase (confirmed by search).
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}
}

ammari.my.id, www.ammari.my.id {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cloudflare/origin-pull-ca.pem
			}
		}
	}
	import web_security_headers
	handle_errors {
		import web_security_headers
		respond "{http.error.status_code}"
	}
	# /api/revalidate is called ONLY over the INTERNAL Docker network (apps/admin ->
	# http://web:3000, bypassing Caddy entirely — see deploy/docker-compose.yml) and never needs
	# the public domain. Blocked here too, defense in depth: Authenticated Origin Pulls above
	# only proves a request came THROUGH Cloudflare, not that it's a legitimate admin request —
	# every ordinary public visitor is proxied through Cloudflare the same way, so without this
	# block a leaked REVALIDATE_SECRET would still work from the public internet. See
	# docs/plans/storefront-cms.md session 6.
	@revalidate path /api/revalidate*
	respond @revalidate 404
	# The internal cron routes (payment expiry sweep, retention; docs/plans/cart-checkout.md §6.3,
	# §11) are called only by the cron service, straight at web:3000 on the internal network, and
	# also need a bearer secret. Never routed from the public internet, same reasoning as above.
	@internal path /api/internal/*
	respond @internal 404
	# /api/test/* (apps/web's e2e preview-token backdoor) must NEVER be reachable from the
	# public internet, full stop — it is gated in code (NODE_ENV != production AND
	# E2E_TEST_LOGIN=true, see src/lib/preview/e2e-gate.ts), but that gate lives in an env var
	# that this Caddy config has no visibility into, so this block is NOT conditional on
	# whether the gate currently happens to be closed. It is the one layer that holds even if
	# E2E_TEST_LOGIN were ever mistakenly set in the real web.env on this server (env_file
	# entries DO override a Dockerfile's baked NODE_ENV=production — confirmed empirically,
	# this is standard Docker behavior, not something to assume).
	@apitest path /api/test/*
	respond @apitest 404
	reverse_proxy web:3000
}

admin.ammari.my.id {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cloudflare/origin-pull-ca.pem
			}
		}
	}
	import admin_security_headers
	handle_errors {
		import admin_security_headers
		respond "{http.error.status_code}"
	}
	# Same reasoning as web's own /api/test/* block above — apps/admin's e2e sign-in backdoor
	# (/api/test/login) must never be reachable from the public internet regardless of what its
	# own code-level gate currently evaluates to.
	@apitest path /api/test/*
	respond @apitest 404
	reverse_proxy admin:3000
}

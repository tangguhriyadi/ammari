# Dev-environment Caddyfile (docs/deploy.md). Prod will get its own Caddyfile on its own VPS
# later (docs/plans/deploy-dev.md, open question 1) — copy this one as the starting point and
# remove the X-Robots-Tag lines, which exist ONLY because every host in THIS file is a dev host.
#
# The Cloudflare trust boundary lives entirely here, not in ufw (docker publishes its own
# iptables rules that bypass ufw's filtering of published ports — see docs/plans/deploy-dev.md):
#   1. PRIMARY: Cloudflare Authenticated Origin Pulls — `client_auth` below requires the
#      Cloudflare origin-pull client certificate on every TLS handshake. A request that didn't
#      actually come through Cloudflare (direct to the VPS IP) is rejected before any
#      application code — or even an HTTP response — runs.
#   2. DEFENSE IN DEPTH: `cloudflare_only` (imported from deploy/cloudflare/cloudflare-only.caddy,
#      generated by deploy/update-cloudflare-ips.sh from deploy/cloudflare-ips.txt) rejects
#      anything whose remote IP isn't in Cloudflare's published ranges.
#   3. `trusted_proxies` (same source) makes access logs show the real client IP, not
#      Cloudflare's edge IP.
# This is what makes trusting `cf-connecting-ip` in packages/auth's rate limiting (and
# apps/web/src/lib/claim/ip.ts) safe — confirmed by reading that code: both read ONLY that
# header, never X-Forwarded-For, so nothing except Caddy's own enforcement stands between it and
# a spoofed value.
#
# VERIFY BEFORE RELYING ON THIS: `caddy validate --config /opt/ammari/Caddyfile` against the
# Caddy version actually installed on the VPS, then the runbook's own
# "curl the VPS IP directly, bypassing Cloudflare, must fail" step (docs/deploy.md).
{
	import cloudflare/trusted-proxies.caddy
}

import cloudflare/cloudflare-only.caddy

ammari.my.id, www.ammari.my.id {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cloudflare/origin-pull-ca.pem
			}
		}
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy web:3000
}

admin.ammari.my.id {
	import cloudflare_only
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/cloudflare/origin-pull-ca.pem
			}
		}
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy admin:3000
}

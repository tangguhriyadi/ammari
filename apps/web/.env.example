DATABASE_URL=postgresql://ammari:ammari@localhost:5432/ammari

# This app's own origin — used as Better Auth's baseURL AND its only trustedOrigins entry. Also
# decides whether session cookies get the Secure attribute (useSecureCookies = this starting
# with "https://"), so keep it accurate per environment.
# Local: http://localhost:3000 — Dev: https://ammari.my.id — Prod: https://ammari.id
BETTER_AUTH_URL=http://localhost:3000

# Required in production (the customer auth instance refuses to start without it there).
# Generate with: openssl rand -base64 32
# Distinctly named (not the generic BETTER_AUTH_SECRET, and never the staff instance's own
# STAFF_BETTER_AUTH_SECRET in apps/admin) — the two auth instances never share a secret.
CUSTOMER_BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me

# Optional — when unset, the Google sign-in button is hidden and the provider is not
# registered, so local dev works without Google credentials. A SEPARATE OAuth client from
# apps/admin's own GOOGLE_CLIENT_ID/SECRET (different redirect URI, customer-facing consent
# screen) — the two can live in the same Google Cloud project and share one consent screen, as
# two separate "OAuth 2.0 Client ID" credentials within it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery for OTP codes (see @ammari/auth's ResendEmailSender). Shared with apps/admin's
# own staff login — same two vars, same provider account. When unset: local dev prints the OTP
# to the server console; production refuses to start without it (never silently drops an OTP
# email).
RESEND_API_KEY=
EMAIL_FROM=

DATABASE_URL=postgresql://ammari:ammari@localhost:5432/ammari

# This app's own origin — used as Better Auth's baseURL AND its only trustedOrigins entry. Also
# decides whether session cookies get the Secure attribute (useSecureCookies = this starting
# with "https://"), so keep it accurate per environment.
# Local: http://localhost:3000 — Dev: https://ammari.my.id — Prod: https://ammari.id
BETTER_AUTH_URL=http://localhost:3000

# Required in production (the customer auth instance refuses to start without it there).
# Generate with: openssl rand -base64 32
# Distinctly named (not the generic BETTER_AUTH_SECRET, and never the staff instance's own
# STAFF_BETTER_AUTH_SECRET in apps/admin) — the two auth instances never share a secret.
CUSTOMER_BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me

# Optional — when unset, the Google sign-in button is hidden and the provider is not
# registered, so local dev works without Google credentials. A SEPARATE OAuth client from
# apps/admin's own GOOGLE_CLIENT_ID/SECRET (different redirect URI, customer-facing consent
# screen) — the two can live in the same Google Cloud project and share one consent screen, as
# two separate "OAuth 2.0 Client ID" credentials within it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match apps/admin/.env's own REVALIDATE_SECRET exactly — gates POST /api/revalidate
# (docs/plans/storefront-cms.md session 6). Generate with: openssl rand -base64 32. Missing/
# wrong -> a clean 401, never a 500 (lib/revalidate/secret.ts fails closed without leaking
# whether the route exists).
REVALIDATE_SECRET=dev-only-insecure-secret-change-me

# Must match apps/admin/.env's own PREVIEW_SECRET exactly — verifies the signed "Pratinjau" link
# to the draft homepage (/preview/home?token=...). Generate with: openssl rand -base64 32.
PREVIEW_SECRET=dev-only-insecure-secret-change-me

# Email delivery for OTP codes (see @ammari/auth's ResendEmailSender). Shared with apps/admin's
# own staff login — same two vars, same provider account. When unset: local dev prints the OTP
# to the server console; production refuses to start without it (never silently drops an OTP
# email). Also sends the order emails (docs/plans/cart-checkout.md §8); locally they print to
# the console too.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — apps/admin's public origin, for the "Buka di admin" link in the owner's paid-order
# email (to store_settings.support_email). Unset: that email has no link.
ADMIN_SITE_URL=http://localhost:3001

# Optional — whole-system OTP-send-per-hour cap, shared with apps/admin (same
# auth_email_throttle table). Defaults to 300/hour when unset; no reason to set this locally.
OTP_GLOBAL_HOURLY_CAP=

# Public base URL product/content images are served from (lib/storage/public-url.ts) — same
# value as apps/admin's own STORAGE_PUBLIC_BASE_URL (both apps point at the same bucket/CDN).
# apps/web only ever reads this to build a public <img>/next/image URL by string concatenation;
# it never uploads, deletes, or holds any S3 credential. Required to render any product or
# homepage-content image — unset throws loudly (a clean 500, logged) the first time a page tries
# to render one, rather than a page full of silently broken images.
STORAGE_PUBLIC_BASE_URL=

# Temporary stand-in for store_settings.whatsapp_number (docs/plans/storefront-cms.md Phase 2,
# session 8 — not built yet). wa.me format: country code + digits only, no "+" (e.g.
# "6281234567890"). Unset hides the PDP's "Tanya via WhatsApp" button entirely rather than
# rendering a broken link — see lib/store-settings.ts.
STORE_WHATSAPP_NUMBER=

# Feature flag for the "Tambah ke keranjang" UI (lib/cart-flag.ts) — cart/checkout itself ships
# Dec 2026. Defaults OFF (anything other than the literal "true" keeps it hidden); while off, the
# PDP's primary action is "Tanya via WhatsApp" instead. Deliberately NOT a NEXT_PUBLIC_ variable —
# this repo's Docker images are built once and deployed environment-neutral, and a NEXT_PUBLIC_
# value gets baked into the client bundle at `next build` time, which would make the flag
# impossible to flip per-environment without a rebuild. Read server-side only (lib/cart-flag.ts)
# and passed down to the one client component that needs it as a prop.
STOREFRONT_CART_ENABLED=

# --- Checkout (docs/plans/cart-checkout.md §12) -------------------------------------------------
# All optional locally: without them every checkout path fails closed (quotes "Ongkir belum bisa
# dihitung", checkout refuses, the payment notification route answers 503). The e2e runs set the
# fake providers themselves (playwright.config.ts); PAYMENT_PROVIDER=fake and
# SHIPPING_RATE_PROVIDER=fake are refused outside an e2e build, so leave both unset here.
# Midtrans SANDBOX only (key starts with "SB-"); MIDTRANS_IS_PRODUCTION=true is refused unless
# DEPLOY_ENV=production.
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_ORDER_ID_PREFIX=LOCAL-
# Local cannot receive Midtrans notifications; leave empty (the finish page's status check covers
# a local test payment).
MIDTRANS_NOTIFICATION_URL=
CHECKOUT_PAYMENT_EXPIRY_MINUTES=
CHECKOUT_STOCK_HOLD_MINUTES=
# Biteship TEST key only ("biteship_test."); test-mode Maps and Rates are billed per request.
BITESHIP_API_KEY=
BITESHIP_BASE_URL=https://api.biteship.com
BITESHIP_ORIGIN_AREA_ID=
BITESHIP_DAILY_MAPS_BUDGET=
BITESHIP_DAILY_RATES_BUDGET=
SHIPPING_QUOTE_CACHE_MINUTES=
# Optional locally: one of production, dev, development, test (anything else fails closed).
DEPLOY_ENV=development
# Bearer secret for /api/internal/* (sweep, emails, retention); at least 32 characters.
INTERNAL_CRON_SECRET=

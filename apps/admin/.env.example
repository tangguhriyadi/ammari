DATABASE_URL=postgresql://ammari:ammari@localhost:5432/ammari

# This admin app's own origin — used as Better Auth's baseURL AND its only trustedOrigins entry.
# Also what decides whether session cookies get the Secure attribute (useSecureCookies = this
# starting with "https://"), so keep it accurate per environment.
BETTER_AUTH_URL=http://localhost:3001

# apps/web's own public base URL — used to build every claim URL this app generates (the
# packing thank-you card's QR content and its printed human-readable fallback, see
# src/lib/main-site-url.ts and src/lib/packing/token.ts). Validated at module load: must be a
# valid absolute URL, no trailing slash, and https when NODE_ENV=production.
# Local: http://localhost:3000 — Dev: https://ammari.my.id — Prod: https://ammari.id
MAIN_SITE_URL=http://localhost:3000

# Required in production (the staff auth instance refuses to start without it there). Generate
# with: openssl rand -base64 32
# Distinctly named (not the generic BETTER_AUTH_SECRET) so it can never be confused with the
# customer instance's own CUSTOMER_BETTER_AUTH_SECRET in apps/web.
STAFF_BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me

# Optional — when unset, the Google sign-in button is hidden and the provider is not registered,
# so local dev works without Google credentials. A SEPARATE OAuth client from apps/web's own
# GOOGLE_CLIENT_ID/SECRET (different redirect URI) — can live in the same Google Cloud project
# and share one consent screen, as two separate "OAuth 2.0 Client ID" credentials within it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email delivery for staff login OTP codes (see @ammari/auth's ResendEmailSender). Shared with
# apps/web's own customer login — same two vars, same provider account. When unset: local dev
# prints the OTP to the server console; production refuses to start without it.
RESEND_API_KEY=
EMAIL_FROM=

# Optional — whole-system OTP-send-per-hour cap, shared with apps/web (same auth_email_throttle
# table). Defaults to 300/hour when unset; no reason to set this locally.
OTP_GLOBAL_HOURLY_CAP=

# apps/web's INTERNAL base URL — locally this IS just http://localhost:3000 (no Docker network
# involved yet). Used only by POST /api/revalidate calls after "Terbitkan"/a product storefront
# save (src/lib/revalidate.ts, docs/plans/storefront-cms.md session 6) — never required for
# local dev to otherwise work (a failed/misconfigured call never fails the save, just logs).
WEB_INTERNAL_URL=http://localhost:3000

# Must match apps/web/.env's own REVALIDATE_SECRET exactly, or every /api/revalidate call gets a
# clean 401 (logged, harmless locally). Generate with: openssl rand -base64 32.
REVALIDATE_SECRET=dev-only-insecure-secret-change-me

# Must match apps/web/.env's own PREVIEW_SECRET exactly, or every "Pratinjau" link 404s on
# apps/web. Generate with: openssl rand -base64 32.
PREVIEW_SECRET=dev-only-insecure-secret-change-me

# Product image storage (S3-compatible, Cloudflare R2, docs/plans/storage-r2.md). Required for
# any image upload/delete/public-URL code path (see src/lib/storage.ts): that code throws,
# naming exactly which of these is missing, rather than silently falling back to anything. Never
# commit real values.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=ammari-dev
S3_ACCESS_KEY_ID=changeme
S3_SECRET_ACCESS_KEY=changeme
# Keeps environments from colliding in the same bucket: "local/" on laptops, "e2e/" in (real-
# bucket) e2e runs, "dev/" on the dev server. Production uses no prefix (empty string) — but the
# var must still be set explicitly, even to "", so a forgotten config can never silently default.
S3_KEY_PREFIX=local/
# Public URL prefix used to render images (<img src>) — see docs/SPEC.md's storage:check script
# for how to verify this actually serves objects under S3_KEY_PREFIX publicly. Served via a
# Cloudflare custom domain connected to the bucket, not the raw r2.cloudflarestorage.com host.
STORAGE_PUBLIC_BASE_URL=https://img.ammari.my.id

# Set only by apps/admin/playwright.config.ts's webServer.env for e2e runs — forces the in-
# memory StorageClient so e2e needs no real bucket (see src/lib/storage.ts). Fails closed: the
# storage getter throws if this is set while NODE_ENV=production, exactly like E2E_TEST_LOGIN.
# Never set this by hand in apps/admin/.env.
STORAGE_DRIVER=
